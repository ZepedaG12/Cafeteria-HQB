# ============================================================================
# CAMILA'S COFFEE — Variables de Entorno para Producción (Vercel + Neon Postgres)
# ============================================================================
# En Vercel (Storage -> Create Database -> Neon Postgres -> Connect), Vercel
# inyecta automáticamente DATABASE_URL y POSTGRES_URL.
# Si dejas DATABASE_URL vacío al ejecutar en tu PC local, el sistema guarda en
# archivo JSON local automáticamente (data/cafeteria-hospital-db.json).

DATABASE_URL="postgresql://usuario:password@ep-ejemplo-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
